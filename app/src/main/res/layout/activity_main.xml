<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7FDB6C"
    android:outlineProvider="bounds">

    <androidx.cardview.widget.CardView
        android:id="@+id/titleCard"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:translationY="30dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="14dp"
        app:cardUseCompatPadding="true"
        app:contentPadding="10dp"
        app:layout_constraintBottom_toTopOf="@+id/studyStatsLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Welcome to Study Tracker!"
            android:textAlignment="center"
            android:textColor="#D50E0E"
            android:textSize="45sp" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/studyStatsLayout"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:orientation="vertical"
        android:translationY="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleCard">

        <androidx.cardview.widget.CardView
            android:id="@+id/subjectCard1"
            android:layout_width="400dp"
            android:layout_height="120dp"
            android:translationX="5dp"
            android:translationZ="0dp"
            android:visibility="visible"
            app:cardCornerRadius="16dp"
            app:contentPadding="10dp">

            <ProgressBar
                android:id="@+id/progressBar1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:progressTint="#0D11B6"
                android:translationY="60dp" />

            <TextView
                android:id="@+id/subjectText1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foregroundTint="#FFFFFF"
                android:text="English"
                android:textColor="#FF0000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/progressText1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="progress:"
                android:translationY="42dp" />

            <ImageView
                android:id="@+id/englishResetBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationX="355dp"
                android:visibility="visible"
                android:src="@drawable/reset_icon" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/subjectCard2"
            android:layout_width="400dp"
            android:layout_height="120dp"
            android:translationX="5dp"
            android:translationY="5dp"
            android:translationZ="0dp"
            android:visibility="visible"
            app:cardCornerRadius="16dp"
            app:contentPadding="10dp">

            <ProgressBar
                android:id="@+id/progressBar2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:progressTint="#0D11B6"
                android:translationY="60dp" />

            <TextView
                android:id="@+id/subjectText2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foregroundTint="#FFFFFF"
                android:text="Math"
                android:textColor="#FF0000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/progressText2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="progress:"
                android:translationY="42dp" />

            <ImageView
                android:id="@+id/mathResetBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationX="355dp"
                android:src="@drawable/reset_icon" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/subjectCard3"
            android:layout_width="400dp"
            android:layout_height="120dp"
            android:translationX="5dp"
            android:translationY="10dp"
            android:translationZ="0dp"
            android:visibility="visible"
            app:cardCornerRadius="16dp"
            app:contentPadding="10dp">

            <ProgressBar
                android:id="@+id/progressBar3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:progressTint="#0D11B6"
                android:translationY="60dp" />

            <TextView
                android:id="@+id/subjectText3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foregroundTint="#FFFFFF"
                android:text="Science"
                android:textColor="#FF0000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/progressText3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="progress:"
                android:translationY="42dp" />

            <ImageView
                android:id="@+id/scienceResetBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationX="355dp"
                android:src="@drawable/reset_icon" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/subjectCard4"
            android:layout_width="400dp"
            android:layout_height="120dp"
            android:translationX="5dp"
            android:translationY="15dp"
            android:translationZ="0dp"
            android:visibility="visible"
            app:cardCornerRadius="16dp"
            app:contentPadding="10dp">

            <ProgressBar
                android:id="@+id/progressBar4"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:progressTint="#0D11B6"
                android:translationY="60dp" />

            <TextView
                android:id="@+id/subjectText4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foregroundTint="#FFFFFF"
                android:text="History"
                android:textColor="#FF0000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/progressText4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="progress:"
                android:translationY="42dp" />

            <ImageView
                android:id="@+id/historyResetBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:translationX="355dp"
                android:src="@drawable/reset_icon" />
        </androidx.cardview.widget.CardView>


    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/addStudyTimeCard"
        android:layout_width="400dp"
        android:layout_height="120dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        app:layout_constraintBottom_toTopOf="@+id/logStudyTimeBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Spinner
            android:id="@+id/subjectDropdown"
            android:layout_width="150dp"
            android:layout_height="48dp"
            android:outlineProvider="bounds"
            android:translationX="10dp"
            android:translationY="60dp" />

        <TextView
            android:id="@+id/subjectText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subject:"
            android:textColor="#D50E0E"
            android:translationX="15dp"
            android:translationY="40dp" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minutes Studied:"
            android:textColor="#D50E0E"
            android:translationX="210dp"
            android:translationY="40dp" />

        <TextView
            android:id="@+id/logStudyTimeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add your study time!"
            android:textAlignment="center"
            android:textSize="18sp"
            android:translationY="5dp" />

        <EditText
            android:id="@+id/minutesInput"
            android:layout_width="100dp"
            android:layout_height="52dp"
            android:hint="Minutes"
            android:inputType="number"
            android:textColor="#000000"
            android:textSize="14sp"
            android:translationX="210dp"
            android:translationY="55dp" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0D39F2"
            android:textSize="11sp"
            android:translationX="15dp"
            android:translationY="100dp" />

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/logStudyTimeBtn"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="10dp"
        android:text="Log Study Time"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>